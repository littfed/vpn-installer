    else
        echo "--- VLESS Reality ---"
        echo "$vless_uri"
        echo ""
        echo "--- Hysteria 2 ---"
        echo "$hy2_uri"
        echo ""
        if [[ -n "$tuic_uri" ]]; then
            echo "--- TUIC v5 ---"
            echo "$tuic_uri"
            echo ""
        fi
        echo "--- Telegram MTProto ---"
        echo "$tg_uri"
        echo ""
        if [[ -n "$awg_conf" ]]; then
            echo "--- AmneziaWG (.conf) [$selected_device] ---"
            echo "$awg_conf"
            echo ""
        fi
        echo "(Tip: Run 'vpn user show $username --device <name> --qr' to display terminal QR codes)"
    fi
    echo "=========================================================="
}

cmd_user_device_add() {
    local username="${1:-}"
    local devicename="${2:-}"

    if [[ -z "$username" || -z "$devicename" ]]; then
        echo "Error: Username and device name are required." >&2
        echo "Usage: vpn user device add <user> <device>" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os, secrets, base64

users_file = sys.argv[1]
username = sys.argv[2]
devicename = sys.argv[3]

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
user = next((u for u in users if u.get("name") == username), None)
if not user:
    sys.exit(f"Error: User \"{username}\" not found.")

devices = user.setdefault("devices", {})
if devicename in devices:
    sys.exit(f"Error: Device \"{devicename}\" already exists for user \"{username}\".")

def gen_curve25519_local():
    try:
        from cryptography.hazmat.primitives.asymmetric import x25519
        priv = x25519.X25519PrivateKey.generate()
        pub = priv.public_key()
        return (
            base64.b64encode(priv.private_bytes_raw()).decode(),
            base64.b64encode(pub.public_bytes_raw()).decode()
        )
    except Exception:
        P = 2**255 - 19
        A24 = 121665
        def x25519_mult(s_bytes, u_bytes):
            s = int.from_bytes(s_bytes, "little") & ~7
            s &= ~(128 << 248)
            s |= 64 << 248
            u = int.from_bytes(u_bytes, "little") % P
            x1, x2, z2, x3, z3 = u, 1, 0, u, 1
            swap = 0
            for t in reversed(range(255)):
                kt = (s >> t) & 1
                swap ^= kt
                if swap:
                    x2, x3 = x3, x2
                    z2, z3 = z3, z2
                swap = kt
                A = (x2 + z2) % P
                AA = (A * A) % P
                B = (x2 - z2) % P
                BB = (B * B) % P
                E = (AA - BB) % P
                C = (x3 + z3) % P
                D = (x3 - z3) % P
                DA = (D * A) % P
                CB = (C * B) % P
                x3 = pow(DA + CB, 2, P)
                z3 = (x1 * pow(DA - CB, 2, P)) % P
                x2 = (AA * BB) % P
                z2 = (E * (AA + A24 * E)) % P
            if swap:
                x2, x3 = x3, x2
                z2, z3 = z3, z2
            return (x2 * pow(z2, P - 2, P) % P).to_bytes(32, "little")
        priv_bytes = bytearray(secrets.token_bytes(32))
        priv_bytes[0] &= 248
        priv_bytes[31] &= 127
        priv_bytes[31] |= 64
        base_pt = (9).to_bytes(32, "little")
        pub_bytes = x25519_mult(bytes(priv_bytes), base_pt)
        return (base64.b64encode(bytes(priv_bytes)).decode(), base64.b64encode(pub_bytes).decode())

def allocate_awg_ip_local(users_list, subnet_prefix="10.8"):
    used = set()
    for u in users_list:
        if "awg" in u and isinstance(u["awg"], dict) and u["awg"].get("ip"):
            used.add(u["awg"]["ip"].split("/")[0])
        for dev in u.get("devices", {}).values():
            if isinstance(dev, dict) and dev.get("ip"):
                used.add(dev["ip"].split("/")[0])
    for b3 in range(0, 256):
        start_b4 = 2 if b3 == 0 else 1
        for b4 in range(start_b4, 255):
            cand = f"{subnet_prefix}.{b3}.{b4}"
            if cand not in used:
                return f"{cand}/32"
    return f"{subnet_prefix}.255.254/32"

priv, pub = gen_curve25519_local()
ip = allocate_awg_ip_local(users)

devices[devicename] = {
    "private_key": priv,
    "public_key": pub,
    "ip": ip
}

if "awg" not in user or not user["awg"]:
    user["awg"] = devices[devicename]

tmp_u = users_file + ".tmp." + str(os.getpid())
with open(tmp_u, "w", encoding="utf-8") as uf:
    json.dump(data, uf, indent=2, ensure_ascii=False)
os.replace(tmp_u, users_file)

print(json.dumps({"ip": ip, "public_key": pub}))
' "$users_file" "$username" "$devicename" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    local dev_ip dev_pub
    dev_ip=$(echo "$py_res" | run_python -c "import json, sys; print(json.load(sys.stdin)['ip'])")
    dev_pub=$(echo "$py_res" | run_python -c "import json, sys; print(json.load(sys.stdin)['public_key'])")

    trigger_sync
    echo "Device '$devicename' successfully added for user '$username'."
    echo "Allocated IP: $dev_ip"
    echo "Public Key:   $dev_pub"
}

cmd_user_device_del() {
    local username="${1:-}"
    local devicename="${2:-}"

    if [[ -z "$username" || -z "$devicename" ]]; then
        echo "Error: Username and device name are required." >&2
        echo "Usage: vpn user device del <user> <device>" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os

users_file = sys.argv[1]
username = sys.argv[2]
devicename = sys.argv[3]

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
user = next((u for u in users if u.get("name") == username), None)
if not user:
    sys.exit(f"Error: User \"{username}\" not found.")

devices = user.get("devices", {})
if devicename not in devices:
    sys.exit(f"Error: Device \"{devicename}\" not found for user \"{username}\".")

del devices[devicename]

if devices:
    user["awg"] = next(iter(devices.values()))
else:
    user.pop("awg", None)

tmp_u = users_file + ".tmp." + str(os.getpid())
with open(tmp_u, "w", encoding="utf-8") as uf:
    json.dump(data, uf, indent=2, ensure_ascii=False)
os.replace(tmp_u, users_file)
print("ok")
' "$users_file" "$username" "$devicename" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    trigger_sync
    echo "Device '$devicename' successfully removed from user '$username'."
}

cmd_user_device_list() {
    local username="${1:-}"

    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user device list <user>" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os

users_file = sys.argv[1]
username = sys.argv[2]

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
user = next((u for u in users if u.get("name") == username), None)
if not user:
    sys.exit(f"Error: User \"{username}\" not found.")

devices = user.get("devices", {})
if not devices and "awg" in user:
    devices = {"device-1": user["awg"]}

print(json.dumps(devices))
' "$users_file" "$username" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    echo "Devices for user '$username':"
    printf "%-16s %-18s %s\n" "DEVICE" "IP ADDRESS" "PUBLIC KEY"
    printf "%-16s %-18s %s\n" "------" "----------" "----------"

    echo "$py_res" | run_python -c '
import json, sys
data = json.load(sys.stdin)
for dev, info in data.items():
    ip = info.get("ip", "")
    pub = info.get("public_key", "")
    print(f"{dev:<16} {ip:<18} {pub}")
'
}

cmd_user_device() {
    local subaction="${1:-}"
    shift || true

    case "$subaction" in
        add)
            cmd_user_device_add "$@"
            ;;
        del|delete|rm)
            cmd_user_device_del "$@"
            ;;
        list|ls)
            cmd_user_device_list "$@"
            ;;
        *)
            echo "Unknown device action: $subaction" >&2
            echo "Usage: vpn user device [add|del|list] <user> [device]" >&2
            return 1
            ;;
    esac
}

cmd_user_suspend() {
    local username="${1:-}"
    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user suspend <name>" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os

users_file = sys.argv[1]
username = sys.argv[2]

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
target = next((u for u in users if u.get("name") == username), None)
if not target:
    sys.exit(f"Error: User \"{username}\" not found.")

target["status"] = "suspended"

tmp_file = users_file + ".tmp." + str(os.getpid())
with open(tmp_file, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
os.replace(tmp_file, users_file)
print("ok")
' "$users_file" "$username" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    trigger_sync
    echo "User '$username' suspended successfully."
}

cmd_user_enable() {
    local username="${1:-}"
    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user enable <name>" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os

users_file = sys.argv[1]
username = sys.argv[2]

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
target = next((u for u in users if u.get("name") == username), None)
if not target:
    sys.exit(f"Error: User \"{username}\" not found.")

target["status"] = "active"

tmp_file = users_file + ".tmp." + str(os.getpid())
with open(tmp_file, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
os.replace(tmp_file, users_file)
print("ok")
' "$users_file" "$username" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    trigger_sync
    echo "User '$username' enabled successfully."
}

cmd_user_kick() {
    local username=""
    local client_ip=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ip)
                client_ip="$2"
                shift 2
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user kick <name> [--ip <client_ip>]" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    local clash_url="${CLASH_API_URL:-http://127.0.0.1:9090}"
    local clash_secret="${CLASH_API_SECRET:-}"

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os, urllib.request, urllib.error

users_file = sys.argv[1]
username = sys.argv[2]
clash_url = sys.argv[3]
clash_secret = sys.argv[4]

if not os.path.exists(users_file):
    sys.exit("NOT_FOUND")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit("NOT_FOUND")

user = next((u for u in data.get("users", []) if u.get("name") == username), None)
if not user:
    sys.exit("NOT_FOUND")

user_uuid = user.get("uuid", "")

headers = {}
if clash_secret:
    headers["Authorization"] = f"Bearer {clash_secret}"

req = urllib.request.Request(f"{clash_url}/connections", headers=headers, method="GET")
try:
    with urllib.request.urlopen(req, timeout=2) as resp:
        body = resp.read().decode("utf-8")
        conns_data = json.loads(body)
except Exception:
    sys.exit("API_UNREACHABLE")

conns = conns_data.get("connections", [])
deleted = 0
for c in conns:
    meta = c.get("metadata", {})
    if meta.get("user") in (username, user_uuid) or meta.get("uuid") == user_uuid:
        cid = c.get("id")
        if cid:
            del_req = urllib.request.Request(f"{clash_url}/connections/{cid}", headers=headers, method="DELETE")
            try:
                with urllib.request.urlopen(del_req, timeout=2) as dresp:
                    deleted += 1
            except Exception:
                pass

print(f"TERMINATED:{deleted}")
' "$users_file" "$username" "$clash_url" "$clash_secret" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        if [[ "$py_res" == *"NOT_FOUND"* ]]; then
            echo "Error: User '$username' not found." >&2
            return 1
        fi

        # Clash API unreachable - fallback to socket termination
        if [[ -n "$client_ip" ]]; then
            if [[ -n "${MOCK_SS_FILE:-}" ]]; then
                mkdir -p "$(dirname "$MOCK_SS_FILE")"
                echo "ss -K dst $client_ip" >> "$MOCK_SS_FILE"
            elif command -v ss >/dev/null 2>&1; then
                ss -K dst "$client_ip" 2>/dev/null || true
            fi
            echo "Terminated active sockets for user '$username' (IP: $client_ip) via ss."
            return 0
        fi

        if [[ -n "${MOCK_SS_FILE:-}" ]]; then
            mkdir -p "$(dirname "$MOCK_SS_FILE")"
            echo "ss -K for user $username" >> "$MOCK_SS_FILE"
            echo "Terminated active sockets for user '$username' via socket teardown."
            return 0
        fi

        echo "No active connections terminated (Clash API unavailable and no client IP provided)." >&2
        return 0
    fi

    local del_count=0
    if [[ "$py_res" =~ TERMINATED:([0-9]+) ]]; then
        del_count="${BASH_REMATCH[1]}"
    fi

    if [[ "$del_count" -gt 0 ]]; then
        echo "Terminated $del_count active connection(s) for user '$username' via Clash API."
    else
        echo "No active connections found for user '$username' via Clash API."
    fi
}

cmd_user_delete() {
    local username=""
    local force=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force|-y|--yes)
                force=1
                shift
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user delete <name> [--force|-y]" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    # Check existence first
    set +e
    local check_res
    check_res=$(run_python -c '
import json, sys, os
users_file = sys.argv[1]
username = sys.argv[2]
if not os.path.exists(users_file):
    sys.exit(1)
try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
    if any(u.get("name") == username for u in data.get("users", [])):
        sys.exit(0)
except Exception:
    pass
sys.exit(1)
' "$users_file" "$username")
    local check_code=$?
    set -e

    if [[ $check_code -ne 0 ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    # Confirmation prompt if not forced
    if [[ "$force" -ne 1 ]]; then
        printf "Are you sure you want to delete user '%s'? [y/N]: " "$username"
        local confirm=""
        read -r confirm || confirm=""
        if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
            echo "Operation cancelled."
            return 0
        fi
    fi

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os

users_file = sys.argv[1]
username = sys.argv[2]

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
new_users = [u for u in users if u.get("name") != username]
if len(new_users) == len(users):
    sys.exit(f"Error: User \"{username}\" not found.")

data["users"] = new_users
tmp_file = users_file + ".tmp." + str(os.getpid())
with open(tmp_file, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
os.replace(tmp_file, users_file)
print("ok")
' "$users_file" "$username" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    trigger_sync
    echo "User '$username' deleted successfully."
}

cmd_user() {
    local action="${1:-}"
    shift || true

    case "$action" in
        add)
            cmd_user_add "$@"
            ;;
        list)
            cmd_user_list "$@"
            ;;
        show)
            cmd_user_show "$@"
            ;;
        suspend)
            cmd_user_suspend "$@"
            ;;
        enable)
            cmd_user_enable "$@"
            ;;
        kick)
            cmd_user_kick "$@"
            ;;
        delete)
            cmd_user_delete "$@"
            ;;
        device)
            cmd_user_device "$@"
            ;;
        *)
            echo "Unknown user action: $action" >&2
            echo "Usage: vpn user [add|list|show|suspend|enable|kick|delete|device]" >&2
            return 1
            ;;
    esac
}

cmd_system_enable_sub() {
    mkdir -p "$VPN_DIR"
    local users_file="${VPN_DIR}/users.json"
    local manifest_file="${VPN_DIR}/manifest.json"

    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os, secrets

users_file = sys.argv[1]
manifest_file = sys.argv[2]

# 1. Update users.json with 32-byte hex sub_token
if os.path.exists(users_file):
    try:
        with open(users_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        sys.exit(f"Error reading users.json: {e}")
    users = data.get("users", [])
    updated = False
    for u in users:
        token = u.get("sub_token", "")
        if not token or len(token) != 64:
            u["sub_token"] = secrets.token_hex(32)
            updated = True
    if updated or not users:
        tmp_u = users_file + ".tmp." + str(os.getpid())
        with open(tmp_u, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        os.replace(tmp_u, users_file)

# 2. Update manifest.json
manifest = {}
if os.path.exists(manifest_file):
    try:
        with open(manifest_file, "r", encoding="utf-8") as f:
            manifest = json.load(f)
    except Exception:
        pass

manifest["subscription"] = {
    "enabled": True,
    "port": 8088
}
tmp_m = manifest_file + ".tmp." + str(os.getpid())
with open(tmp_m, "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
os.replace(tmp_m, manifest_file)

server_host = manifest.get("server", {}).get("domain") or manifest.get("server", {}).get("ipv4") or "127.0.0.1"
print(server_host)
' "$users_file" "$manifest_file" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "Error enabling subscription: $py_res" >&2
        return 1
    fi

    local server_host="$py_res"

    # Start or restart sub-server container if docker compose is used
    if [[ -f "$COMPOSE_FILE" ]] && command -v docker >/dev/null 2>&1; then
        docker compose -f "$COMPOSE_FILE" up -d sub-server 2>/dev/null || true
    fi

    echo "=========================================================="
    echo "Adaptive Subscription Endpoint Enabled"
    echo "=========================================================="
    echo "Listening Port:  8088 (Proxied by Caddy)"
    echo "Subscription Base: https://${server_host}/sub/<token>"
    echo "Status:          Active"
    echo "=========================================================="
}

cmd_system_disable_sub() {
    local manifest_file="${VPN_DIR}/manifest.json"

    if [[ -f "$manifest_file" ]]; then
        run_python -c '
import json, sys, os
manifest_file = sys.argv[1]
with open(manifest_file, "r", encoding="utf-8") as f:
    manifest = json.load(f)
if "subscription" not in manifest:
    manifest["subscription"] = {}
manifest["subscription"]["enabled"] = False
tmp_m = manifest_file + ".tmp." + str(os.getpid())
with open(tmp_m, "w", encoding="utf-8") as f:
    json.dump(manifest, f, indent=2, ensure_ascii=False)
os.replace(tmp_m, manifest_file)
' "$manifest_file" 2>/dev/null || true
    fi

    # Stop sub-server container
    if [[ -f "$COMPOSE_FILE" ]] && command -v docker >/dev/null 2>&1; then
        docker compose -f "$COMPOSE_FILE" stop sub-server 2>/dev/null || true
    fi

    echo "Subscription endpoint disabled."
}

cmd_system_sub_status() {
    local manifest_file="${VPN_DIR}/manifest.json"
    local enabled="false"
    local port="8088"
    if [[ -f "$manifest_file" ]]; then
        enabled=$(run_python -c "import json; m=json.load(open('$manifest_file')); print(m.get('subscription',{}).get('enabled', False))" 2>/dev/null || echo "false")
        port=$(run_python -c "import json; m=json.load(open('$manifest_file')); print(m.get('subscription',{}).get('port', 8088))" 2>/dev/null || echo "8088")
    fi
    echo "Subscription Endpoint Status:"
    echo "  Enabled: $enabled"
    echo "  Internal Port: $port"
}

cmd_system_harden() {
    local dry_run=0
    local mock_mode="${MOCK_HARDEN:-0}"
    local auto_yes=0

    for arg in "$@"; do
        case "$arg" in
            --dry-run)
                dry_run=1
                ;;
            --mock)
                mock_mode=1
                ;;
            -y|--yes)
                auto_yes=1
                ;;
        esac
    done

    echo "=========================================================="
    echo "       Host Security Hardening (littfed/server-setup)      "
    echo "=========================================================="
    echo "Upstream repository: https://github.com/littfed/server-setup"
    echo "Includes: SSH key hardening, fail2ban intrusion prevention, unattended-upgrades security patches."
    echo ""

    if [[ "$dry_run" -eq 1 ]]; then
        echo "[Dry-Run] The following command would be executed:"
        echo "  curl -fsSL https://raw.githubusercontent.com/littfed/server-setup/main/setup.sh | bash"
        return 0
    fi

    if [[ "$mock_mode" -eq 1 ]]; then
        echo "[✓] [MOCK] Server security hardening completed successfully via littfed/server-setup."
        return 0
    fi

    if [[ "$auto_yes" -ne 1 ]]; then
        read -r -p "Do you want to proceed with host system hardening? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
            echo "Security hardening cancelled."
            return 0
        fi
    fi

    echo "[+] Running server-setup hardening..."
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://raw.githubusercontent.com/littfed/server-setup/main/setup.sh | bash
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- https://raw.githubusercontent.com/littfed/server-setup/main/setup.sh | bash
    else
        echo "Error: Neither curl nor wget is installed." >&2
        return 1
    fi
    echo "[✓] Host system hardening completed."
}

cmd_system() {
    local action="${1:-}"
    shift || true

    case "$action" in
        enable-sub)
            cmd_system_enable_sub "$@"
            ;;
        disable-sub)
            cmd_system_disable_sub "$@"
            ;;
        status|sub-status)
            cmd_system_sub_status "$@"
            ;;
        harden)
            cmd_system_harden "$@"
            ;;
        *)
            echo "Error: Unknown system action '$action'." >&2
            echo "Usage: vpn system {enable-sub|disable-sub|status|harden}" >&2
            return 1
            ;;
    esac
}

cmd_backup() {
    local target_archive="${1:-}"
    if [[ ! -d "$VPN_DIR" ]]; then
        echo "Error: VPN directory not found at $VPN_DIR" >&2
        return 1
    fi

    if [[ -z "$target_archive" ]]; then
        local backups_dir="${VPN_DIR}/backups"
        mkdir -p "$backups_dir"
        local timestamp
        timestamp="$(date +%Y%m%d_%H%M%S)"
        target_archive="${backups_dir}/vpn-backup-${timestamp}.tar.gz"
    fi

    local target_dir
    target_dir="$(dirname "$target_archive")"
    mkdir -p "$target_dir"

    echo "[+] Creating backup archive of vpn-installer configurations..."

    # Collect existing items from VPN_DIR to archive
    local items=()
    for item in manifest.json users.json docker-compose.yml config.json Caddyfile caddy certs templates sub scripts; do
        if [[ -e "${VPN_DIR}/${item}" ]]; then
            items+=("$item")
        fi
    done

    if [[ ${#items[@]} -eq 0 ]]; then
        echo "Error: No configuration files found in $VPN_DIR to backup." >&2
        return 1
    fi

    local tar_flags=("-czf")
    if tar --help 2>&1 | grep -q -- '--force-local'; then
        tar_flags=("--force-local" "-czf")
    fi

    tar "${tar_flags[@]}" "$target_archive" -C "$VPN_DIR" "${items[@]}"
    chmod 600 "$target_archive" 2>/dev/null || true

    local size
    size=$(du -h "$target_archive" 2>/dev/null | cut -f1 || echo "created")
    echo "[✓] Backup archive created successfully: $target_archive ($size)"
}

cmd_restore() {
    local archive="${1:-}"
    if [[ -z "$archive" ]]; then
        echo "Error: Backup archive path required." >&2
        echo "Usage: vpn restore <archive.tar.gz>" >&2
        return 1
    fi

    if [[ ! -f "$archive" ]]; then
        echo "Error: Archive file not found: $archive" >&2
        return 1
    fi

    echo "[+] Validating backup archive: $archive..."
    local tar_flags_t=("-tzf")
    local tar_flags_x=("-xzf")
    if tar --help 2>&1 | grep -q -- '--force-local'; then
        tar_flags_t=("--force-local" "-tzf")
        tar_flags_x=("--force-local" "-xzf")
    fi

    local archive_contents
    if ! archive_contents=$(tar "${tar_flags_t[@]}" "$archive" 2>/dev/null); then
        echo "Error: Invalid or corrupted tar.gz archive: $archive" >&2
        return 1
    fi

    if ! echo "$archive_contents" | grep -q -E '(manifest\.json|users\.json|docker-compose\.yml)'; then
        echo "Error: Archive does not contain valid vpn-installer configurations." >&2
        return 1
    fi

    echo "[+] Restoring configuration to $VPN_DIR..."
    mkdir -p "$VPN_DIR"
    tar "${tar_flags_x[@]}" "$archive" -C "$VPN_DIR"

    # Restore secure permissions
    chmod 700 "$VPN_DIR" 2>/dev/null || true
    chmod 600 "$VPN_DIR"/*.json 2>/dev/null || true
    if [[ -d "$VPN_DIR/certs" ]]; then
        chmod 600 "$VPN_DIR"/certs/* 2>/dev/null || true
    fi

    # Validate json files
    if [[ -f "$VPN_DIR/manifest.json" ]]; then
        if ! run_python -c "import json; json.load(open('$VPN_DIR/manifest.json'))" 2>/dev/null; then
            echo "Error: Restored manifest.json is invalid JSON." >&2
            return 1
        fi
    fi
    if [[ -f "$VPN_DIR/users.json" ]]; then
        if ! run_python -c "import json; json.load(open('$VPN_DIR/users.json'))" 2>/dev/null; then
            echo "Error: Restored users.json is invalid JSON." >&2
            return 1
        fi
    fi

    # Restart services
    echo "[+] Restarting VPN services..."
    if [[ -f "$COMPOSE_FILE" ]]; then
        docker compose -f "$COMPOSE_FILE" restart 2>/dev/null || docker-compose -f "$COMPOSE_FILE" restart 2>/dev/null || true
    fi

    echo "[✓] Configuration restored successfully from $archive."
}

cmd_test_leak() {
    echo "=========================================================="
    echo "       VPN Installer - Leak Detection & Privacy Audit      "
    echo "=========================================================="

    if [[ "${MOCK_LEAK_TEST:-0}" == "1" ]]; then
        echo "[1/4] Public IPv4 Check: 198.51.100.1"
        echo "      Datacenter / ASN: AS13335 (Cloudflare / Clean)"
        echo "[2/4] Public IPv6 Check: Disabled / No Dual-Stack leak"
        echo "[3/4] DNS Leak Check: Upstream DNS: 1.1.1.1 (Cloudflare DoT/DoH, no ISP leak)"
        echo "[4/4] Cloudflare WARP Egress Check: warp=on (Active)"
        echo "[✓] WebRTC Leak Protection: Protected via Sing-box TUN strict_route"
        echo "=========================================================="
        return 0
    fi

    # 1. Public IPv4
    echo -n "[1/4] Public IPv4 Check... "
    local ipv4="Unavailable"
    if command -v curl >/dev/null 2>&1; then
        ipv4=$(curl -fsSL4 --connect-timeout 5 https://api4.ipify.org 2>/dev/null || curl -fsSL4 --connect-timeout 5 https://icanhazip.com 2>/dev/null || echo "Unavailable")
    fi
    echo "$ipv4"

    # 2. Public IPv6
    echo -n "[2/4] Public IPv6 (Dual-Stack Leak Check)... "
    local ipv6="Unavailable"
    if command -v curl >/dev/null 2>&1; then
        ipv6=$(curl -fsSL6 --connect-timeout 3 https://api6.ipify.org 2>/dev/null || echo "Unavailable")
    fi
    if [[ "$ipv6" == "Unavailable" || -z "$ipv6" ]]; then
        echo "[OK] IPv6 disabled or blocked (no leak)"
    else
        echo "[!] Active IPv6 detected: $ipv6"
        echo "    If your VPN routes only IPv4, IPv6 traffic could bypass tunnel!"
    fi

    # 3. DNS Leak Check
    echo -n "[3/4] DNS Leak Check... "
    local dns_info="Unknown"
    if command -v curl >/dev/null 2>&1; then
        dns_info=$(curl -fsSL --connect-timeout 5 https://edns.ip-api.com/json 2>/dev/null || true)
    fi
    if [[ -n "$dns_info" && "$dns_info" != "Unknown" ]]; then
        local dns_ip
        dns_ip=$(echo "$dns_info" | grep -o '"ip"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | cut -d'"' -f4 || true)
        echo "Resolver IP: ${dns_ip:-Clean}"
    else
        echo "[i] Upstream DNS queries secure (encrypted via DoH/DoT)."
    fi

    # 4. Cloudflare WARP Egress Check
    echo -n "[4/4] Cloudflare WARP Egress Check... "
    local warp_trace=""
    if command -v curl >/dev/null 2>&1; then
        warp_trace=$(curl -fsSL --connect-timeout 5 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)
    fi
    if echo "$warp_trace" | grep -q "warp=on"; then
        echo "[OK] warp=on (WARP Egress Active)"
    elif echo "$warp_trace" | grep -q "warp=plus"; then
        echo "[OK] warp=plus (WARP+ Active)"
    else
        echo "[i] warp=off or direct egress"
    fi

    echo ""
    echo "[✓] WebRTC Leak Protection: Enforced via Sing-box TUN strict_route & direct block."
    echo "=========================================================="
}

cmd_uninstall() {
    local force=0
    local keep_data=0
    local purge=0

    for arg in "$@"; do
        case "$arg" in
            --force|-f|-y|--yes)
                force=1
                ;;
            --keep-data)
                keep_data=1
                ;;
            --purge)
                purge=1
                ;;
        esac
    done

    echo "=========================================================="
    echo "             VPN Installer - Node Uninstall               "
    echo "=========================================================="

    if [[ "$force" -ne 1 ]]; then
        read -r -p "Are you sure you want to completely uninstall vpn-installer? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[yY]([eE][sS])?$ ]]; then
            echo "Uninstall cancelled."
            return 0
        fi

        if [[ "$keep_data" -ne 1 && "$purge" -ne 1 ]]; then
            read -r -p "Keep configuration and user data in $VPN_DIR? [Y/n]: " keep_confirm
            if [[ ! "$keep_confirm" =~ ^[nN][oO]?$ ]]; then
                keep_data=1
            fi
        fi
    fi

    echo "[+] Stopping and removing Docker containers..."
    if [[ -f "$COMPOSE_FILE" ]]; then
        docker compose -f "$COMPOSE_FILE" down -v --remove-orphans 2>/dev/null || docker-compose -f "$COMPOSE_FILE" down -v --remove-orphans 2>/dev/null || true
    elif command -v docker >/dev/null 2>&1; then
        docker compose down -v --remove-orphans 2>/dev/null || docker-compose down -v --remove-orphans 2>/dev/null || true
    fi

    echo "[+] Tearing down firewall and port-hopping rules..."
    local fw_script=""
    if [[ -f "${VPN_DIR}/scripts/firewall-setup.sh" ]]; then
        fw_script="${VPN_DIR}/scripts/firewall-setup.sh"
    elif [[ -f "${REPO_ROOT}/scripts/firewall-setup.sh" ]]; then
        fw_script="${REPO_ROOT}/scripts/firewall-setup.sh"
    elif [[ -f "${SCRIPT_DIR}/../scripts/firewall-setup.sh" ]]; then
        fw_script="${SCRIPT_DIR}/../scripts/firewall-setup.sh"
    fi

    if [[ -n "$fw_script" ]]; then
        bash "$fw_script" --teardown 2>/dev/null || true
    fi

    echo "[+] Removing CLI symlink..."
    rm -f "${BIN_DIR}/vpn" /usr/local/bin/vpn 2>/dev/null || true

    if [[ "$keep_data" -eq 1 ]]; then
        echo "[✓] vpn-installer uninstalled (configuration kept in $VPN_DIR)."
    else
        echo "[+] Purging $VPN_DIR..."
        rm -rf "$VPN_DIR"
        echo "[✓] vpn-installer completely uninstalled and data removed."
    fi
}

cmd_probe() {
    local probe_script=""
    if [[ -f "${VPN_DIR}/scripts/canary-probe.py" ]]; then
        probe_script="${VPN_DIR}/scripts/canary-probe.py"
    elif [[ -f "${SCRIPT_DIR}/../scripts/canary-probe.py" ]]; then
        probe_script="${SCRIPT_DIR}/../scripts/canary-probe.py"
    elif [[ -f "${REPO_ROOT}/scripts/canary-probe.py" ]]; then
        probe_script="${REPO_ROOT}/scripts/canary-probe.py"
    fi

    if [[ -z "$probe_script" || ! -f "$probe_script" ]]; then
        echo "Error: canary-probe.py not found." >&2
        return 1
    fi

    local nodes_file="${VPN_DIR}/nodes.json"
    if [[ ! -f "$nodes_file" && -f "${VPN_DIR}/manifest.json" ]]; then
        nodes_file="${VPN_DIR}/manifest.json"
    elif [[ ! -f "$nodes_file" && -f "nodes.json" ]]; then
        nodes_file="nodes.json"
    fi

    run_python "$probe_script" \
        --nodes-file "$nodes_file" \
        --health-file "${VPN_DIR}/node-health.json" \
        --users-file "${VPN_DIR}/users.json" \
        "$@"
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        status)
            cmd_status "$@"
            ;;
        service)
            cmd_service "$@"
            ;;
        user)
            cmd_user "$@"
            ;;
        system)
            cmd_system "$@"
            ;;
        backup)
            cmd_backup "$@"
            ;;
        restore)
            cmd_restore "$@"
            ;;
        test-leak)
            cmd_test_leak "$@"
            ;;
        probe)
            cmd_probe "$@"
            ;;
        node)
            local subcmd="${1:-}"
            if [[ "$subcmd" == "test" || "$subcmd" == "check" || "$subcmd" == "probe" ]]; then
                shift
                cmd_probe "$@"
            else
                echo "Usage: vpn node <test|check|probe> [args]" >&2
                return 1
            fi
            ;;
        uninstall)
            cmd_uninstall "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo "Error: Unknown command '$command'" >&2
            show_help
            exit 1
            ;;
    esac
}

main "$@"
