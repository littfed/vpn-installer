#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

VPN_DIR="${VPN_DIR:-/opt/vpn-installer}"
BIN_DIR="${BIN_DIR:-/usr/local/bin}"
MANIFEST_FILE="${VPN_DIR}/manifest.json"
COMPOSE_FILE="${VPN_DIR}/docker-compose.yml"
MOCK_SIGHUP_FILE="${MOCK_SIGHUP_FILE:-}"

run_python() {
    if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
        python3 "$@"
    elif command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
        python "$@"
    else
        echo "Error: Python runtime not found." >&2
        return 1
    fi
}

render_qr() {
    local text="$1"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 "$text" 2>/dev/null || qrencode -t UTF8 "$text" 2>/dev/null || qrencode -t ASCII "$text"
    elif run_python -c "import qrcode, sys; qr = qrcode.QRCode(); qr.add_data(sys.argv[1]); qr.print_ascii(invert=True)" "$text" 2>/dev/null; then
        :
    else
        echo "[!] Notice: Install 'qrencode' to view terminal QR codes."
    fi
}

show_help() {
    cat << 'EOF'
vpn - Censorship-Resistant VPN Node Management CLI

Usage:
  vpn <command> [arguments]

Available Commands:
  status                   Show node status, services, and listening ports
  service <action>         Manage background services (start, stop, restart, reload, logs)
  user <action> [args]     Manage users (add, list, show, suspend, enable, kick, delete, device)
  system <action>          Manage system components (enable-sub, disable-sub, status, harden)
  backup [file]            Create backup archive (.tar.gz) of node configurations
  restore <archive>        Restore node configuration from backup archive
  test-leak                Run diagnostic audit for IP, DNS, WebRTC, and WARP leaks
  probe [args]             Run Canary Probe synthetic audit from Russia against nodes
  uninstall [--force]      Uninstall node containers, firewall rules, and CLI
  help                     Show this help message

Probe Actions:
  vpn probe [--node <name>] [--protocol <vless|hy2|tuic|awg|mtproto>] [--json]
                           Run synthetic audit from Russia against foreign nodes

User Actions:
  vpn user add <name>            Add a new user (with device-1 and device-2)
  vpn user list                  List all users
  vpn user show <name> [--device <name>] [--qr]
                                 Show user connection URIs and QR codes
  vpn user suspend <name>        Suspend user access without deleting keys
  vpn user enable <name>         Restore suspended user access
  vpn user kick <name>           Terminate active user connections
  vpn user delete <name> [-y]    Delete user permanently
  vpn user device add <u <d>     Add a new AmneziaWG device for user
  vpn user device del <u <d>     Delete AmneziaWG device from user
  vpn user device list <user>    List all devices for user

System Actions:
  vpn system enable-sub          Enable adaptive subscription endpoint (/sub/<token>)
  vpn system disable-sub         Disable adaptive subscription endpoint
  vpn system status              Show subscription endpoint status
  vpn system harden [--dry-run]  Run OS security hardening (littfed/server-setup)

Maintenance Actions:
  vpn backup [file]              Create backup archive (.tar.gz)
  vpn restore <archive>          Restore configuration and restart node
  vpn test-leak                  Run leak detection and WARP egress audit
  vpn uninstall [--force]        Uninstall services, remove symlink and clean firewall

Service Actions:
  vpn service start        Start all containers
  vpn service stop         Stop all containers
  vpn service restart      Restart all containers
  vpn service reload       Reload sing-box config via SIGHUP
  vpn service logs [args]  View container logs

EOF
}

cmd_status() {
    echo "=========================================================="
    echo "           VPN Installer - Node Status                    "
    echo "=========================================================="

    if [[ ! -f "$MANIFEST_FILE" ]]; then
        echo "Error: Manifest file not found at $MANIFEST_FILE" >&2
        echo "Please run install.sh first." >&2
        return 1
    fi

    # Read manifest info
    local node_uuid=""
    local server_ip=""
    local server_domain=""
    local reality_port="443"
    local reality_sni=""
    local hy2_port="443"
    local mtproto_port="8443"

    if command -v jq >/dev/null 2>&1; then
        node_uuid=$(jq -r '.node_uuid // empty' "$MANIFEST_FILE")
        server_ip=$(jq -r '.server.ipv4 // empty' "$MANIFEST_FILE")
        server_domain=$(jq -r '.server.domain // empty' "$MANIFEST_FILE")
        reality_port=$(jq -r '.protocols.vless_reality.port // "443"' "$MANIFEST_FILE")
        reality_sni=$(jq -r '.protocols.vless_reality.sni // empty' "$MANIFEST_FILE")
        hy2_port=$(jq -r '.protocols.hysteria2.port // "443"' "$MANIFEST_FILE")
        mtproto_port=$(jq -r '.protocols.mtproto.port // "8443"' "$MANIFEST_FILE")
    else
        node_uuid=$(grep -o '"node_uuid": *"[^"]*"' "$MANIFEST_FILE" | cut -d'"' -f4 || true)
        server_ip=$(grep -o '"ipv4": *"[^"]*"' "$MANIFEST_FILE" | cut -d'"' -f4 || true)
        server_domain=$(grep -o '"domain": *"[^"]*"' "$MANIFEST_FILE" | cut -d'"' -f4 || true)
        reality_sni=$(grep -o '"sni": *"[^"]*"' "$MANIFEST_FILE" | cut -d'"' -f4 || true)
        mtproto_port=$(run_python -c "import json; m=json.load(open('$MANIFEST_FILE')); print(m.get('protocols',{}).get('mtproto',{}).get('port', 8443))" 2>/dev/null || echo "8443")
    fi

    echo "Node UUID:     ${node_uuid:-unknown}"
    echo "Server IP:     ${server_ip:-unknown}"
    if [[ -n "$server_domain" ]]; then
        echo "Decoy Domain:  ${server_domain}"
    fi
    echo "Decoy SNI:     ${reality_sni:-unknown}"
    echo ""
    echo "Configured Services:"
    echo "  - VLESS Reality:  ${reality_port}/TCP (XTLS-Vision)"
    echo "  - Hysteria 2:     ${hy2_port}/UDP (Salamander Obfs)"
    echo "  - TUIC v5:        8443/UDP (BBR Congestion Control)"
    echo "  - AmneziaWG:      48291/UDP (v2.0/v3.1 Header Protection)"
    echo "  - MTProto Proxy:  ${mtproto_port}/TCP (Fake-TLS mtg v2)"
    echo "  - Decoy (Caddy):  80/TCP & 127.0.0.1:8443 (HTTP-01 & Reality Fallback)"
    echo ""

    echo "--- Service Container Status ---"
    if [[ -f "$COMPOSE_FILE" ]] && command -v docker >/dev/null 2>&1; then
        docker compose -f "$COMPOSE_FILE" ps || echo "Unable to query Docker Compose."
    else
        echo "Docker Compose file not found or Docker not available."
    fi
    echo ""

    echo "--- Listening Network Ports ---"
    local tcp_listening="no"
    local udp_listening="no"
    local tuic_listening="no"
    local awg_listening="no"
    local mtproto_listening="no"
    local http_listening="no"
    local caddy_internal="no"

    if command -v ss >/dev/null 2>&1; then
        if ss -tln | grep -E -q ":${reality_port}\b"; then
            tcp_listening="yes"
        fi
        if ss -uln | grep -E -q ":${hy2_port}\b"; then
            udp_listening="yes"
        fi
        if ss -uln | grep -E -q ":8443\b"; then
            tuic_listening="yes"
        fi
        if ss -uln | grep -E -q ":48291\b"; then
            awg_listening="yes"
        fi
        if ss -tln | grep -E -q ":${mtproto_port}\b"; then
            mtproto_listening="yes"
        fi
        if ss -tln | grep -E -q ":80\b"; then
            http_listening="yes"
        fi
        if ss -tln | grep -E -q "127\.0\.0\.1:8443\b"; then
            caddy_internal="yes"
        fi
    elif command -v netstat >/dev/null 2>&1; then
        if netstat -tln | grep -E -q ":${reality_port}\b"; then
            tcp_listening="yes"
        fi
        if netstat -uln | grep -E -q ":${hy2_port}\b"; then
            udp_listening="yes"
        fi
        if netstat -uln | grep -E -q ":8443\b"; then
            tuic_listening="yes"
        fi
        if netstat -uln | grep -E -q ":48291\b"; then
            awg_listening="yes"
        fi
        if netstat -tln | grep -E -q ":${mtproto_port}\b"; then
            mtproto_listening="yes"
        fi
        if netstat -tln | grep -E -q ":80\b"; then
            http_listening="yes"
        fi
        if netstat -tln | grep -E -q "127\.0\.0\.1:8443\b"; then
            caddy_internal="yes"
        fi
    else
        tcp_listening="active (containerized)"
        udp_listening="active (containerized)"
        tuic_listening="active (containerized)"
        awg_listening="active (containerized)"
        mtproto_listening="active (containerized)"
        http_listening="active (containerized)"
        caddy_internal="active (containerized)"
    fi

    echo "  Port ${reality_port}/TCP (VLESS Reality): ${tcp_listening}"
    echo "  Port ${hy2_port}/UDP (Hysteria 2):    ${udp_listening}"
    echo "  Port 8443/UDP (TUIC v5):             ${tuic_listening}"
    echo "  Port 48291/UDP (AmneziaWG):          ${awg_listening}"
    echo "  Port ${mtproto_port}/TCP (MTProto Proxy):  ${mtproto_listening}"
    echo "  Port 80/TCP (Caddy HTTP-01/Decoy):   ${http_listening}"
    echo "  Port 8443/TCP (Caddy Reality Target): ${caddy_internal}"
    echo "=========================================================="
}

cmd_service() {
    local action="${1:-}"
    shift || true

    if [[ ! -f "$COMPOSE_FILE" ]]; then
        echo "Error: Docker Compose file not found at $COMPOSE_FILE" >&2
        return 1
    fi

    case "$action" in
        start)
            docker compose -f "$COMPOSE_FILE" up -d "$@"
            ;;
        stop)
            docker compose -f "$COMPOSE_FILE" down "$@"
            ;;
        restart)
            docker compose -f "$COMPOSE_FILE" restart "$@"
            ;;
        reload)
            echo "Hot-reloading service configurations..."
            docker compose -f "$COMPOSE_FILE" kill -s HUP sing-box 2>/dev/null || true
            docker compose -f "$COMPOSE_FILE" exec -T caddy caddy reload --config /etc/caddy/Caddyfile 2>/dev/null || true
            echo "Reload signal sent successfully."
            ;;
        logs)
            docker compose -f "$COMPOSE_FILE" logs "$@"
            ;;
        check)
            docker compose -f "$COMPOSE_FILE" exec sing-box sing-box check -c /etc/sing-box/config.json
            ;;
        *)
            echo "Unknown service action: $action" >&2
            echo "Usage: vpn service [start|stop|restart|reload|logs|check]" >&2
            return 1
            ;;
    esac
}

trigger_sync() {
    local sync_script=""
    if [[ -f "${VPN_DIR}/scripts/user-sync.sh" ]]; then
        sync_script="${VPN_DIR}/scripts/user-sync.sh"
    elif [[ -f "${SCRIPT_DIR}/../scripts/user-sync.sh" ]]; then
        sync_script="${SCRIPT_DIR}/../scripts/user-sync.sh"
    elif [[ -f "${SCRIPT_DIR}/user-sync.sh" ]]; then
        sync_script="${SCRIPT_DIR}/user-sync.sh"
    fi

    if [[ -n "$sync_script" ]]; then
        VPN_DIR="$VPN_DIR" MOCK_SIGHUP_FILE="$MOCK_SIGHUP_FILE" bash "$sync_script"
    fi
}

cmd_user_add() {
    local username="${1:-}"
    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user add <name>" >&2
        return 1
    fi

    if [[ ! "$username" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Error: Invalid username '$username'. Use only alphanumeric characters, dashes, and underscores." >&2
        return 1
    fi

    mkdir -p "$VPN_DIR"
    local users_file="${VPN_DIR}/users.json"

    # Add user to users.json via python
    set +e
    local py_res
    py_res=$(run_python -c '
import json, sys, os, uuid, secrets, base64
from datetime import datetime, timezone

users_file = sys.argv[1]
username = sys.argv[2]
manifest_file = sys.argv[3] if len(sys.argv) > 3 else ""

data = {"users": []}
if os.path.exists(users_file):
    try:
        with open(users_file, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        sys.exit(f"Error reading users.json: {e}")

users = data.get("users", [])
for u in users:
    if u.get("name") == username:
        sys.exit(f"Error: User \"{username}\" already exists.")

def gen_curve25519():
    try:
        from cryptography.hazmat.primitives.asymmetric import x25519
        priv = x25519.X25519PrivateKey.generate()
        pub = priv.public_key()
        return (
            base64.b64encode(priv.private_bytes_raw()).decode(),
            base64.b64encode(pub.public_bytes_raw()).decode()
        )
    except Exception:
        import shutil, subprocess
        for bin_name in ["awg", "wg"]:
            bin_path = shutil.which(bin_name)
            if bin_path:
                try:
                    res_p = subprocess.run([bin_path, "genkey"], stdout=subprocess.PIPE, text=True)
                    pk = res_p.stdout.strip()
                    res_pub = subprocess.run([bin_path, "pubkey"], input=pk, stdout=subprocess.PIPE, text=True)
                    pubk = res_pub.stdout.strip()
                    if pk and pubk:
                        return (pk, pubk)
                except Exception:
                    pass
        # Fallback pure python X25519
        P = 2**255 - 19
        A24 = 121665
        def x25519_mult(s_bytes, u_bytes):
            s = int.from_bytes(s_bytes, "little") & ~7
            s &= ~(128 << 248)
            s |= 64 << 248
            u = int.from_bytes(u_bytes, "little") % P
            x1, x2, z2, x3, z3 = u, 1, 0, u, 1
            swap = 0
            for t in reversed(range(255)):
                kt = (s >> t) & 1
                swap ^= kt
                if swap:
                    x2, x3 = x3, x2
                    z2, z3 = z3, z2
                swap = kt
                A = (x2 + z2) % P
                AA = (A * A) % P
                B = (x2 - z2) % P
                BB = (B * B) % P
                E = (AA - BB) % P
                C = (x3 + z3) % P
                D = (x3 - z3) % P
                DA = (D * A) % P
                CB = (C * B) % P
                x3 = pow(DA + CB, 2, P)
                z3 = (x1 * pow(DA - CB, 2, P)) % P
                x2 = (AA * BB) % P
                z2 = (E * (AA + A24 * E)) % P
            if swap:
                x2, x3 = x3, x2
                z2, z3 = z3, z2
            return (x2 * pow(z2, P - 2, P) % P).to_bytes(32, "little")
        priv_bytes = bytearray(secrets.token_bytes(32))
        priv_bytes[0] &= 248
        priv_bytes[31] &= 127
        priv_bytes[31] |= 64
        base_pt = (9).to_bytes(32, "little")
        pub_bytes = x25519_mult(bytes(priv_bytes), base_pt)
        return (base64.b64encode(bytes(priv_bytes)).decode(), base64.b64encode(pub_bytes).decode())

def allocate_awg_ip(users_list, subnet_prefix="10.8"):
    used = set()
    for u in users_list:
        if "awg" in u and isinstance(u["awg"], dict) and u["awg"].get("ip"):
            used.add(u["awg"]["ip"].split("/")[0])
        for dev in u.get("devices", {}).values():
            if isinstance(dev, dict) and dev.get("ip"):
                used.add(dev["ip"].split("/")[0])
    for b3 in range(0, 256):
        start_b4 = 2 if b3 == 0 else 1
        for b4 in range(start_b4, 255):
            cand = f"{subnet_prefix}.{b3}.{b4}"
            if cand not in used:
                return f"{cand}/32"
    return f"{subnet_prefix}.255.254/32"

# Migrate any existing users missing awg block or devices
for u in users:
    devs = u.setdefault("devices", {})
    if "awg" in u and isinstance(u["awg"], dict) and u["awg"].get("private_key"):
        if "device-1" not in devs:
            devs["device-1"] = {
                "private_key": u["awg"]["private_key"],
                "public_key": u["awg"].get("public_key", ""),
                "ip": u["awg"].get("ip") or allocate_awg_ip(users)
            }
    elif "device-1" not in devs:
        k_priv, k_pub = gen_curve25519()
        devs["device-1"] = {
            "private_key": k_priv,
            "public_key": k_pub,
            "ip": allocate_awg_ip(users)
        }
    if "device-2" not in devs:
        k_priv2, k_pub2 = gen_curve25519()
        devs["device-2"] = {
            "private_key": k_priv2,
            "public_key": k_pub2,
            "ip": allocate_awg_ip(users)
        }
    u["awg"] = devs["device-1"]

tg_secret = ""
if manifest_file and os.path.exists(manifest_file):
    try:
        with open(manifest_file, "r", encoding="utf-8") as mf:
            m = json.load(mf)
            tg_secret = m.get("protocols", {}).get("mtproto", {}).get("secret", "")
    except Exception:
        pass

if not tg_secret:
    dom_hex = "www.cloudflare.com".encode("utf-8").hex()
    tg_secret = f"ee{secrets.token_hex(16)}{dom_hex}"

awg_priv1, awg_pub1 = gen_curve25519()
awg_ip1 = allocate_awg_ip(users)
dev1 = {
    "private_key": awg_priv1,
    "public_key": awg_pub1,
    "ip": awg_ip1
}

temp_user = {"devices": {"device-1": dev1}}
awg_priv2, awg_pub2 = gen_curve25519()
awg_ip2 = allocate_awg_ip(users + [temp_user])
dev2 = {
    "private_key": awg_priv2,
    "public_key": awg_pub2,
    "ip": awg_ip2
}

new_user = {
    "name": username,
    "uuid": str(uuid.uuid4()).lower(),
    "password": secrets.token_urlsafe(18),
    "sub_key": base64.b64encode(secrets.token_bytes(32)).decode(),
    "tg_secret": tg_secret,
    "sub_token": secrets.token_hex(32),
    "awg": dev1,
    "devices": {
        "device-1": dev1,
        "device-2": dev2
    },
    "status": "active",
    "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
}

users.append(new_user)
data["users"] = users

tmp_users = users_file + ".tmp." + str(os.getpid())
with open(tmp_users, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
os.replace(tmp_users, users_file)
print(new_user["uuid"])
' "$users_file" "$username" "$MANIFEST_FILE" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_res" >&2
        return 1
    fi

    local user_uuid="$py_res"

    # Run user sync
    trigger_sync

    echo "User '$username' added successfully (UUID: $user_uuid)."
}

cmd_user_list() {
    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "No users found."
        return 0
    fi

    run_python -c '
import json, sys, os

users_file = sys.argv[1]
if not os.path.exists(users_file):
    print("No users found.")
    sys.exit(0)

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    print("No users found.")
    sys.exit(0)

users = data.get("users", [])
if not users:
    print("No users found.")
    sys.exit(0)

print(f"NAME                 STATUS     CREATED AT             UUID")
print("-" * 86)
for u in users:
    n = u.get("name", "")
    s = u.get("status", "")
    c = u.get("created_at", "")
    uid = u.get("uuid", "")
    print(f"{n:<20} {s:<10} {c:<22} {uid}")
' "$users_file"
}

cmd_user_show() {
    local username=""
    local qr_mode=0
    local device_name=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --qr|-q)
                qr_mode=1
                shift
                ;;
            --device|-d)
                device_name="${2:-}"
                shift 2 || shift
                ;;
            *)
                if [[ -z "$username" ]]; then
                    username="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$username" ]]; then
        echo "Error: Username is required." >&2
        echo "Usage: vpn user show <name> [--device <device>] [--qr]" >&2
        return 1
    fi

    local users_file="${VPN_DIR}/users.json"
    if [[ ! -f "$users_file" ]]; then
        echo "Error: User '$username' not found." >&2
        return 1
    fi

    set +e
    local py_output
    py_output=$(run_python -c '
import json, sys, os, secrets, base64

users_file = sys.argv[1]
manifest_file = sys.argv[2]
username = sys.argv[3]
req_device = sys.argv[4] if len(sys.argv) > 4 else ""

if not os.path.exists(users_file):
    sys.exit(f"Error: User \"{username}\" not found.")

try:
    with open(users_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception as e:
    sys.exit(f"Error reading users.json: {e}")

user = next((u for u in data.get("users", []) if u.get("name") == username), None)
if not user:
    sys.exit(f"Error: User \"{username}\" not found.")

server_ip = os.environ.get("SERVER_IP", "")
reality_port = "443"
reality_sni = "gateway.icloud.com"
reality_pbk = ""
reality_sid = ""
hy2_port = "443"
hy2_obfs = ""
hy2_pin = ""
mtproto_port = "8443"
mtproto_secret = ""

if os.path.exists(manifest_file):
    try:
        with open(manifest_file, "r", encoding="utf-8") as mf:
            m = json.load(mf)
            if not server_ip:
                server_ip = m.get("server", {}).get("ipv4") or m.get("server", {}).get("domain") or "127.0.0.1"
            vless = m.get("protocols", {}).get("vless_reality", {})
            reality_port = str(vless.get("port", "443"))
            reality_sni = vless.get("sni", "gateway.icloud.com")
            reality_pbk = vless.get("public_key", "")
            reality_sid = vless.get("short_id", "")

            hy2 = m.get("protocols", {}).get("hysteria2", {})
            hy2_port = str(hy2.get("port", "443"))
            hy2_obfs = hy2.get("obfs_password", "")
            hy2_pin = hy2.get("pin_sha256", "")
            if not hy2_pin:
                cert_file = os.path.join(vpn_dir, "certs", "fullchain.pem")
                if os.path.exists(cert_file):
                    try:
                        import base64, hashlib
                        with open(cert_file, "r", encoding="utf-8") as cf:
                            b64 = "".join([l.strip() for l in cf if not l.startswith("-----")])
                            hy2_pin = hashlib.sha256(base64.b64decode(b64)).hexdigest().lower()
                    except Exception:
                        pass

            mtp = m.get("protocols", {}).get("mtproto", {})
            mtproto_port = str(mtp.get("port", "8443"))
            mtproto_secret = mtp.get("secret", "")
    except Exception:
        pass

if not server_ip:
    server_ip = "127.0.0.1"

uuid = user.get("uuid", "")
password = user.get("password", "")

tg_secret = user.get("tg_secret", "")
if not tg_secret or not tg_secret.startswith("ee"):
    tg_secret = mtproto_secret
if not tg_secret:
    dom_hex = "www.cloudflare.com".encode("utf-8").hex()
    tg_secret = f"ee000102030405060708090a0b0c0d0e0f{dom_hex}"

vless_uri = f"vless://{uuid}@{server_ip}:{reality_port}?security=reality&flow=xtls-rprx-vision&pbk={reality_pbk}&sni={reality_sni}&sid={reality_sid}&fp=chrome#{username}-Reality"
if hy2_pin:
    hy2_uri = f"hysteria2://{password}@{server_ip}:{hy2_port}/?sni={reality_sni}&obfs=salamander&obfs-password={hy2_obfs}&pinSHA256={hy2_pin}&pinnedPeerCertSha256={hy2_pin}#{username}-Hy2"
else:
    hy2_uri = f"hysteria2://{password}@{server_ip}:{hy2_port}/?sni={reality_sni}&obfs=salamander&obfs-password={hy2_obfs}&insecure=1#{username}-Hy2"
tg_uri = f"tg://proxy?server={server_ip}&port={mtproto_port}&secret={tg_secret}#{username}"

sub_token = user.get("sub_token", "")
domain = ""
if os.path.exists(manifest_file):
    try:
        with open(manifest_file, "r", encoding="utf-8") as mf:
            m = json.load(mf)
            domain = m.get("server", {}).get("domain") or ""
    except Exception:
        pass
sub_host = domain if domain else server_ip
sub_url = f"https://{sub_host}/sub/{sub_token}" if sub_token else ""

tuic_proto = m.get("protocols", {}).get("tuic", {}) if "m" in locals() and m else {}
tuic_uri = ""
if tuic_proto and tuic_proto.get("enabled", True):
    tuic_port = tuic_proto.get("port", 8443)
    tuic_uri = f"tuic://{uuid}:{password}@{server_ip}:{tuic_port}?congestion_control=bbr&alpn=h3&sni={reality_sni}&allow_insecure=1#{username}-TUIC"

awg_conf = ""
awg_proto = m.get("protocols", {}).get("amneziawg", {}) if "m" in locals() and m else {}
def gen_curve25519_local():
    try:
        from cryptography.hazmat.primitives.asymmetric import x25519
        priv = x25519.X25519PrivateKey.generate()
        pub = priv.public_key()
        return (
            base64.b64encode(priv.private_bytes_raw()).decode(),
            base64.b64encode(pub.public_bytes_raw()).decode()
        )
    except Exception:
        P = 2**255 - 19
        A24 = 121665
        def x25519_mult(s_bytes, u_bytes):
            s = int.from_bytes(s_bytes, "little") & ~7
            s &= ~(128 << 248)
            s |= 64 << 248
            u = int.from_bytes(u_bytes, "little") % P
            x1, x2, z2, x3, z3 = u, 1, 0, u, 1
            swap = 0
            for t in reversed(range(255)):
                kt = (s >> t) & 1
                swap ^= kt
                if swap:
                    x2, x3 = x3, x2
                    z2, z3 = z3, z2
                swap = kt
                A = (x2 + z2) % P
                AA = (A * A) % P
                B = (x2 - z2) % P
                BB = (B * B) % P
                E = (AA - BB) % P
                C = (x3 + z3) % P
                D = (x3 - z3) % P
                DA = (D * A) % P
                CB = (C * B) % P
                x3 = pow(DA + CB, 2, P)
                z3 = (x1 * pow(DA - CB, 2, P)) % P
                x2 = (AA * BB) % P
                z2 = (E * (AA + A24 * E)) % P
            if swap:
                x2, x3 = x3, x2
                z2, z3 = z3, z2
            return (x2 * pow(z2, P - 2, P) % P).to_bytes(32, "little")
        priv_bytes = bytearray(secrets.token_bytes(32))
        priv_bytes[0] &= 248
        priv_bytes[31] &= 127
        priv_bytes[31] |= 64
        base_pt = (9).to_bytes(32, "little")
        pub_bytes = x25519_mult(bytes(priv_bytes), base_pt)
        return (base64.b64encode(bytes(priv_bytes)).decode(), base64.b64encode(pub_bytes).decode())

def allocate_awg_ip_local(users_list, subnet_prefix="10.8"):
    used = set()
    for u in users_list:
        if "awg" in u and isinstance(u["awg"], dict) and u["awg"].get("ip"):
            used.add(u["awg"]["ip"].split("/")[0])
        for dev in u.get("devices", {}).values():
            if isinstance(dev, dict) and dev.get("ip"):
                used.add(dev["ip"].split("/")[0])
    for b3 in range(0, 256):
        start_b4 = 2 if b3 == 0 else 1
        for b4 in range(start_b4, 255):
            cand = f"{subnet_prefix}.{b3}.{b4}"
            if cand not in used:
                return f"{cand}/32"
    return f"{subnet_prefix}.255.254/32"

devices = user.setdefault("devices", {})
if "awg" in user and isinstance(user["awg"], dict) and user["awg"].get("private_key"):
    if "device-1" not in devices:
        devices["device-1"] = {
            "private_key": user["awg"]["private_key"],
            "public_key": user["awg"].get("public_key", ""),
            "ip": user["awg"].get("ip", "10.8.0.2/32")
        }

if "device-1" not in devices:
    priv1, pub1 = gen_curve25519_local()
    ip1 = allocate_awg_ip_local(data.get("users", []))
    devices["device-1"] = {"private_key": priv1, "public_key": pub1, "ip": ip1}

if "device-2" not in devices:
    priv2, pub2 = gen_curve25519_local()
    ip2 = allocate_awg_ip_local(data.get("users", []))
    devices["device-2"] = {"private_key": priv2, "public_key": pub2, "ip": ip2}

user["awg"] = devices["device-1"]

try:
    tmp_u = users_file + ".tmp." + str(os.getpid())
    with open(tmp_u, "w", encoding="utf-8") as uf:
        json.dump(data, uf, indent=2, ensure_ascii=False)
    os.replace(tmp_u, users_file)
except Exception:
    pass

if req_device:
    if req_device not in devices:
        sys.exit(f"Error: Device \"{req_device}\" not found for user \"{username}\". Available devices: {list(devices.keys())}")
    selected_device = req_device
    user_awg = devices[req_device]
else:
    selected_device = "device-1"
    user_awg = devices.get("device-1") or next(iter(devices.values()))

if awg_proto and user_awg and user_awg.get("private_key"):
    awg_port = str(awg_proto.get("port", "48291"))
    awg_pub = awg_proto.get("public_key", "")
    jc = awg_proto.get("jc", 5)
    jmin = awg_proto.get("jmin", 40)
    jmax = awg_proto.get("jmax", 70)
    s1 = awg_proto.get("s1", 35)
    s2 = awg_proto.get("s2", 55)
    h1 = awg_proto.get("h1", 123456)
    h2 = awg_proto.get("h2", 234567)
    h3 = awg_proto.get("h3", 345678)
    h4 = awg_proto.get("h4", 456789)
    client_priv = user_awg.get("private_key", "")
    client_ip = user_awg.get("ip", "10.8.0.2/32")
    awg_conf = f"""[Interface]
PrivateKey = {client_priv}
Address = {client_ip}
DNS = 1.1.1.1, 77.88.8.8
Jc = {jc}
Jmin = {jmin}
Jmax = {jmax}
S1 = {s1}
S2 = {s2}
H1 = {h1}
H2 = {h2}
H3 = {h3}
H4 = {h4}

[Peer]
PublicKey = {awg_pub}
Endpoint = {server_ip}:{awg_port}
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25"""

out = {
    "name": username,
    "status": user.get("status", "active"),
    "uuid": uuid,
    "vless_uri": vless_uri,
    "hy2_uri": hy2_uri,
    "tuic_uri": tuic_uri,
    "tg_uri": tg_uri,
    "sub_url": sub_url,
    "awg_conf": awg_conf,
    "selected_device": selected_device,
    "devices": {k: {"ip": v.get("ip", ""), "public_key": v.get("public_key", "")} for k, v in devices.items()}
}
print(json.dumps(out))
' "$users_file" "$MANIFEST_FILE" "$username" "$device_name" 2>&1)
    local py_exit=$?
    set -e

    if [[ $py_exit -ne 0 ]]; then
        echo "$py_output" >&2
        return 1
    fi

    local vless_uri hy2_uri tuic_uri tg_uri user_status user_uuid sub_url awg_conf selected_device devices_summary
    vless_uri=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin)['vless_uri'])")
    hy2_uri=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin)['hy2_uri'])")
    tuic_uri=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin).get('tuic_uri', ''))")
    tg_uri=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin)['tg_uri'])")
    sub_url=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin).get('sub_url', ''))")
    user_status=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin)['status'])")
    user_uuid=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin)['uuid'])")
    awg_conf=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin).get('awg_conf', ''))")
    selected_device=$(echo "$py_output" | run_python -c "import json, sys; print(json.load(sys.stdin).get('selected_device', 'device-1'))")
    devices_summary=$(echo "$py_output" | run_python -c "import json, sys; d = json.load(sys.stdin).get('devices', {}); print(', '.join([f'{k} ({v.get(\"ip\", \"\")})' for k, v in d.items()]))")

    echo "=========================================================="
    echo "User:   $username ($user_status)"
    echo "UUID:   $user_uuid"
    echo "=========================================================="
    echo ""

    if [[ -n "$sub_url" ]]; then
        echo "--- Subscription URL ---"
        echo "$sub_url"
        echo ""
    fi

    if [[ -n "$devices_summary" ]]; then
        echo "--- AmneziaWG Devices ---"
        echo "Registered: $devices_summary"
        echo "Active view: $selected_device"
        echo ""
    fi

    if [[ "$qr_mode" -eq 1 ]]; then
        if [[ -n "$sub_url" ]]; then
            echo "--- Subscription QR Code ---"
            render_qr "$sub_url"
            echo ""
        fi
        echo "--- VLESS Reality ---"
        echo "$vless_uri"
        echo ""
        echo "--- VLESS Reality QR Code ---"
        render_qr "$vless_uri"
        echo ""
        echo "--- Hysteria 2 ---"
        echo "$hy2_uri"
        echo ""
        echo "--- Hysteria 2 QR Code ---"
        render_qr "$hy2_uri"
        echo ""
        if [[ -n "$tuic_uri" ]]; then
            echo "--- TUIC v5 ---"
            echo "$tuic_uri"
            echo ""
            echo "--- TUIC v5 QR Code ---"
            render_qr "$tuic_uri"
            echo ""
        fi
